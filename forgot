<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>FinançaMinha — Recuperar senha</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700&family=Instrument+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    :root {
      --bg:#09090d;--s1:#111318;--s2:#181b22;--s3:#1e2230;
      --b1:rgba(255,255,255,.09);--b2:rgba(255,255,255,.15);
      --text:#eeeef0;--muted:#7a7f96;--dim:#4a4f66;
      --red:#f87171;--green:#4ade80;--acc:#c8ff57;
      --ff:'Syne',sans-serif;--fb:'Instrument Sans',sans-serif;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    body{background:var(--bg);color:var(--text);font-family:var(--fb);font-size:14px;min-height:100vh}
    button{font-family:var(--fb);cursor:pointer}
    input{font-family:var(--fb)}
    .wrap{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:1rem}
    .box{width:100%;max-width:400px}
    .logo{text-align:center;margin-bottom:2rem}
    .logo-title{font-family:var(--ff);font-size:28px;font-weight:700;color:var(--acc);letter-spacing:-.5px}
    .logo-sub{font-size:13px;color:var(--muted);margin-top:4px}
    .card{background:var(--s1);border:1px solid var(--b1);border-radius:16px;padding:2rem}
    .card-title{font-family:var(--ff);font-size:18px;font-weight:700;color:var(--text);margin-bottom:.5rem}
    .card-desc{font-size:13px;color:var(--muted);margin-bottom:1.5rem;line-height:1.5}
    .field{margin-bottom:1.5rem}
    label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px;letter-spacing:.03em;text-transform:uppercase}
    input[type=email],input[type=password]{width:100%;padding:10px 12px;background:var(--s2);border:1px solid var(--b1);border-radius:8px;color:var(--text);font-size:14px;outline:none;transition:border-color .15s}
    input:focus{border-color:var(--acc)}
    .btn{width:100%;padding:12px;background:var(--acc);color:#09090d;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;transition:opacity .15s}
    .btn:hover{opacity:.88}
    .btn:disabled{opacity:.5;cursor:not-allowed}
    .btn-ghost{width:100%;padding:11px;background:none;color:var(--muted);border:1px solid var(--b1);border-radius:8px;font-size:14px;cursor:pointer;transition:all .15s;margin-top:10px}
    .btn-ghost:hover{border-color:var(--b2);color:var(--text)}
    .msg{margin-top:1rem;font-size:13px;text-align:center;min-height:20px;line-height:1.5}
    .footer{text-align:center;margin-top:1.25rem;font-size:12px;color:var(--dim)}
    .hidden{display:none}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="box">
      <div class="logo">
        <div class="logo-title">FinançaMinha</div>
        <div class="logo-sub">gestão financeira familiar</div>
      </div>
      <div class="card">

        <!-- Tela 1: pedir e-mail para envio do link -->
        <div id="screen-request">
          <div class="card-title">Recuperar senha</div>
          <div class="card-desc">Informe seu e-mail e enviaremos um link para criar uma nova senha.</div>
          <div class="field">
            <label>E-mail</label>
            <input id="email" type="email" placeholder="seu@email.com" onkeydown="if(event.key==='Enter')doRequestReset()">
          </div>
          <button class="btn" id="btn-request" onclick="doRequestReset()">Enviar link</button>
          <button class="btn-ghost" onclick="location.href='index.html'">Voltar para o login</button>
          <div class="msg" id="msg-request"></div>
        </div>

        <!-- Tela 2: definir nova senha (após clicar no link do e-mail) -->
        <div id="screen-new-pass" class="hidden">
          <div class="card-title">Nova senha</div>
          <div class="card-desc">Escolha uma nova senha para sua conta.</div>
          <div class="field">
            <label>Nova senha</label>
            <input id="new-pass" type="password" placeholder="Mínimo 6 caracteres" onkeydown="if(event.key==='Enter')doSetNewPass()">
          </div>
          <div class="field">
            <label>Confirmar senha</label>
            <input id="confirm-pass" type="password" placeholder="Repita a senha" onkeydown="if(event.key==='Enter')doSetNewPass()">
          </div>
          <button class="btn" id="btn-newpass" onclick="doSetNewPass()">Salvar nova senha</button>
          <div class="msg" id="msg-newpass"></div>
        </div>

      </div>
      <div class="footer">Seus dados ficam salvos na nuvem com segurança.</div>
    </div>
  </div>

  <script>
    const SUPABASE_URL = 'https://iapsjwiahrngytrxawrj.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_6rRbVuPIfuF56utFPfVzLg_waXyH5XS';
    const _sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    function setMsg(id, html, isError = true) {
      const el = document.getElementById(id);
      el.innerHTML = html;
      el.style.color = isError ? 'var(--red)' : 'var(--green)';
    }

    // Detecta se veio do link de recuperação (hash da URL ou evento Supabase)
    _sb.auth.onAuthStateChange((event, session) => {
      if (event === 'PASSWORD_RECOVERY') {
        showNewPassScreen();
      }
      // Se já logado normalmente (não recovery), redireciona pro app
      if (event === 'SIGNED_IN' && session && !window._isRecovery) {
        location.href = 'app.html';
      }
    });

    // Verifica hash na URL para o caso do evento já ter disparado antes do listener
    (function checkHash() {
      const hash = window.location.hash;
      if (hash.includes('type=recovery') || hash.includes('type=magiclink')) {
        window._isRecovery = true;
        showNewPassScreen();
      }
    })();

    function showNewPassScreen() {
      window._isRecovery = true;
      document.getElementById('screen-request').classList.add('hidden');
      document.getElementById('screen-new-pass').classList.remove('hidden');
    }

    async function doRequestReset() {
      const email = document.getElementById('email').value.trim();
      if (!email) { setMsg('msg-request', 'Informe seu e-mail.'); return; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setMsg('msg-request', 'E-mail inválido.'); return; }

      const btn = document.getElementById('btn-request');
      btn.disabled = true; btn.textContent = 'Enviando…';

      const redirectTo = window.location.origin + window.location.pathname.replace('forgot.html', 'forgot.html');
      const { error } = await _sb.auth.resetPasswordForEmail(email, { redirectTo });

      btn.disabled = false; btn.textContent = 'Enviar link';

      if (error) {
        setMsg('msg-request', error.message.includes('Too many requests') ? '⏳ Muitas tentativas. Aguarde alguns minutos.' : error.message);
      } else {
        setMsg('msg-request', '📧 Link enviado para <strong>' + email + '</strong>. Verifique também o spam.', false);
      }
    }

    async function doSetNewPass() {
      const newPass     = document.getElementById('new-pass').value;
      const confirmPass = document.getElementById('confirm-pass').value;

      if (newPass.length < 6)      { setMsg('msg-newpass', 'Senha deve ter pelo menos 6 caracteres.'); return; }
      if (newPass !== confirmPass)  { setMsg('msg-newpass', 'As senhas não coincidem.'); return; }

      const btn = document.getElementById('btn-newpass');
      btn.disabled = true; btn.textContent = 'Salvando…';

      const { error } = await _sb.auth.updateUser({ password: newPass });

      btn.disabled = false; btn.textContent = 'Salvar nova senha';

      if (error) {
        setMsg('msg-newpass', error.message);
      } else {
        setMsg('msg-newpass', '✅ Senha atualizada com sucesso!', false);
        setTimeout(() => { location.href = 'index.html'; }, 1800);
      }
    }
  </script>
</body>
</html>
